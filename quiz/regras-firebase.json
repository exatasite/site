{
  "rules": {
    "professores": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email != null",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null"
      }
    },
    "biblioteca": {
      ".read": "auth != null && auth.token.email != null",
      ".write": "auth != null && auth.token.email === 'wpsexatas@gmail.com'"
    },
    "salas": {
      ".indexOn": ["dono"],
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === data.child('dono').val() || auth.uid === newData.child('dono').val())",
        "jogadores": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && !data.exists() && root.child('salas').child($pin).child('estado').exists() && root.child('salas').child($pin).child('estado').val() !== 'fim'",
            ".validate": "newData.child('nome').isString() && newData.child('nome').val().length >= 2 && newData.child('nome').val().length <= 20 && (auth.uid === root.child('salas').child($pin).child('dono').val() || (!newData.child('pontos').exists() && !newData.child('acertos').exists() && !newData.child('seq').exists()))"
          }
        },
        "respostas": {
          "$q": {
            "$pid": {
              ".write": "auth != null && auth.uid === $pid && !data.exists() && root.child('salas').child($pin).child('jogadores').child($pid).exists() && root.child('salas').child($pin).child('atual').child('chave').val() === $q && root.child('salas').child($pin).child('atual').child('fase').val() === 'pergunta'",
              ".validate": "newData.child('k').isNumber() && newData.child('k').val() >= 0 && newData.child('k').val() <= 3 && newData.child('t').val() === now"
            }
          }
        }
      }
    }
  }
}
