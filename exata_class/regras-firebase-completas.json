{
  "rules": {
    "professores": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email != null",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null"
      }
    },
    "biblioteca": {
      ".read": "auth != null && auth.token.email != null",
      ".write": "auth != null && auth.token.email === 'wpsexatas@gmail.com'"
    },
    "salas": {
      ".indexOn": [
        "dono"
      ],
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === data.child('dono').val() || auth.uid === newData.child('dono').val())",
        "jogadores": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && !data.exists() && root.child('salas').child($pin).child('estado').exists() && root.child('salas').child($pin).child('estado').val() !== 'fim'",
            ".validate": "newData.child('nome').isString() && newData.child('nome').val().length >= 2 && newData.child('nome').val().length <= 20 && (auth.uid === root.child('salas').child($pin).child('dono').val() || (!newData.child('pontos').exists() && !newData.child('acertos').exists() && !newData.child('seq').exists()))"
          }
        },
        "respostas": {
          "$q": {
            "$pid": {
              ".write": "auth != null && auth.uid === $pid && !data.exists() && root.child('salas').child($pin).child('jogadores').child($pid).exists() && root.child('salas').child($pin).child('atual').child('chave').val() === $q && root.child('salas').child($pin).child('atual').child('fase').val() === 'pergunta'",
              ".validate": "newData.child('k').isNumber() && newData.child('k').val() >= 0 && newData.child('k').val() <= 3 && newData.child('t').val() === now"
            }
          }
        }
      }
    },
    "cabos": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && auth.token.email != null && auth.uid === newData.child('dono').val()) || (data.exists() && auth.uid === data.child('dono').val()))",
        "jogadores": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('cabos').child($pin).exists() && root.child('cabos').child($pin).child('estado').val() !== 'fim' && (root.child('cabos').child($pin).child('estado').val() === 'lobby' || !data.child('equipe').exists())",
            ".validate": "newData.hasChildren(['nome', 'avatar', 'entrou']) && newData.child('nome').isString() && newData.child('nome').val().length >= 2 && newData.child('nome').val().length <= 20 && (!newData.child('equipe').exists() || newData.child('equipe').val() === 'azul' || newData.child('equipe').val() === 'vermelha')"
          }
        },
        "respostas": {
          "$indice": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('cabos').child($pin).child('jogadores').child($uid).exists() && root.child('cabos').child($pin).child('estado').val() === 'pergunta' && root.child('cabos').child($pin).child('indiceTexto').val() === $indice",
              ".validate": "newData.hasChildren(['opcao', 'equipe', 'tempo']) && newData.child('opcao').isNumber() && newData.child('opcao').val() >= 0 && newData.child('opcao').val() <= 5 && newData.child('equipe').val() === root.child('cabos').child($pin).child('jogadores').child($uid).child('equipe').val()"
            }
          }
        }
      }
    },
    "unoPotencia": {
      "rooms": {
        "$pin": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && auth.uid === newData.child('host').val()) || (data.exists() && (auth.uid === data.child('host').val() || newData.child('players').child(auth.uid).exists())))"
        }
      }
    },
    "class": {
      "turmas": {
        "$cod": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email != null && ((!data.exists() && newData.child('dono').val() === auth.uid) || (data.exists() && data.child('dono').val() === auth.uid))",
          "nome": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60"
          },
          "materiais": {
            "$id": {
              ".validate": "newData.hasChildren(['titulo', 'tipo', 'link']) && newData.child('titulo').isString() && newData.child('titulo').val().length <= 120 && newData.child('link').isString() && newData.child('link').val().matches(/^https:\\/\\/.+/) && newData.child('link').val().length <= 800"
            }
          }
        }
      },
      "rascunhos": {
        "$cod": {
          ".read": "auth != null && root.child('class/turmas/' + $cod + '/dono').val() === auth.uid",
          ".write": "auth != null && auth.token.email != null && root.child('class/turmas/' + $cod + '/dono').val() === auth.uid",
          "$id": {
            ".validate": "newData.hasChildren(['titulo', 'tipo', 'link']) && newData.child('titulo').isString() && newData.child('titulo').val().length <= 120 && newData.child('link').isString() && newData.child('link').val().matches(/^https:\\/\\/.+/) && newData.child('link').val().length <= 800"
          }
        }
      },
      "alunos": {
        "$cod": {
          ".read": "auth != null && root.child('class/turmas/' + $cod + '/dono').val() === auth.uid",
          ".write": "auth != null && root.child('class/turmas/' + $cod + '/dono').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('class/turmas/' + $cod).exists()",
            ".validate": "newData.hasChildren(['nome', 'entrou']) && newData.child('nome').isString() && newData.child('nome').val().length >= 2 && newData.child('nome').val().length <= 40"
          }
        }
      },
      "professores": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth.token.email != null"
        }
      }
    }
  }
}